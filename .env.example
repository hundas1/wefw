# Copy to .env (git-ignored) and fill in. Never paste these values into chat.
RAPIER_IBKR_HOST=127.0.0.1
RAPIER_IBKR_DATA_PORT=4001        # IB Gateway live 4001 / paper 4002; TWS 7496 / 7497
RAPIER_IBKR_ORDER_PORT=4002       # only for --broker ibkr-paper rehearsals
RAPIER_ROOT=MNQ                   # MNQ (sizes 1:1) or NQ (sizes / 10)

RAPIER_TRADARA_ACCOUNT=           # Tradara account id to trade
RAPIER_TRADARA_ALLOWED_ACCOUNTS=  # comma list; orders to any other account are refused
RAPIER_TRADARA_TOKEN_FILE=data/tradara-token.json   # written by `rapier tradara-login` (chmod 600)

RAPIER_DISCORD_WEBHOOK=           # optional: order / error notifications
# RAPIER_I_UNDERSTAND_REAL_ORDERS=yes   # required together with --arm
